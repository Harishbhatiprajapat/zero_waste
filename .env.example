# ========================================================
# ANN-DAAN AI - Environment Variables Configuration
# ========================================================

# Application Configuration
APP_NAME="ANN-DAAN AI"
APP_VERSION="1.0.0"
API_PREFIX="/api"

# Secret Key for JWT Authentication
SECRET_KEY="anndaan-ai-super-secret-jwt-key-rajasthan-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is local SQLite (with embedded Haversine spatial calculations)
# For production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://user:password@localhost:5432/anndaan_db"
DATABASE_URL="sqlite:///./anndaan.db"

# Regional Pilot Node (Jaipur, Rajasthan)
PILOT_CITY="Jaipur"
DEFAULT_LATITUDE=26.9124
DEFAULT_LONGITUDE=75.7873

# Optional Vision AI & Object Storage Keys
# If not provided, platform seamlessly uses embedded heuristic safety models
GEMINI_API_KEY=""
CLOUDINARY_URL=""

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

